# ---------------------------------------------------------------------------
# Campus Customs (HW4) — strict .gitignore
# ---------------------------------------------------------------------------

# --- Secrets: never commit the real .env (the example stays tracked) ---
.env
.env.*
!.env.example

# --- Local data pack: added locally, never committed ---
# The database and product imagery ship separately; place them under data/.
data/
data/campus_customs.db
data/products/
# Any stray database or raw product images anywhere in the tree
*.db
*.sqlite
*.sqlite3
**/products/*.jpg
**/products/*.jpeg
**/products/*.png
**/products/*.webp

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.log
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
