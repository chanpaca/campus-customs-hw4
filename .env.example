# ---------------------------------------------------------------------------
# Campus Customs — environment template
# Copy this file to .env and fill in your own values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- LLM gateway (required) ---
# Portkey is an OpenAI-compatible gateway; the backend reaches gpt-4o-mini through it.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_MODEL=gpt-4o-mini
# Optional — defaults to Portkey's public endpoint if unset.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Optional — set a Portkey virtual key if your account uses one.
# PORTKEY_VIRTUAL_KEY=your_virtual_key_here

# --- App configuration (all optional; sensible defaults shown) ---
# Secret used to sign session tokens. Set a long random value in production.
# CAMPUS_CUSTOMS_SECRET=change-me-to-a-long-random-string
# Absolute path to campus_customs.db, if it is not under ./data or ./HW 4/data/data.
# CAMPUS_CUSTOMS_DB=/absolute/path/to/campus_customs.db
# Seconds to wait for the agent before returning a 504.
# CHAT_TIMEOUT_SECONDS=30
